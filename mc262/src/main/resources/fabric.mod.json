{
	"schemaVersion": 1,
	"id": "tellus",
	"version": "${version}",
	"name": "NZ Terrain",
	"description": "New Zealand terrain from real data. A fork of Tellus, which recreates real-world terrain in Minecraft from geographic data.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://github.com/Yucareux/Tellus",
		"sources": "https://github.com/Yucareux/Tellus"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/tellus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.yucareux.tellus.Tellus"
		],
		"client": [
			"com.yucareux.tellus.TellusClient"
		]
	},
	"mixins": [
		"tellus.mixins.json",
		{
			"config": "tellus.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "nz-terrain.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"distanthorizons": "*"
	}
}
